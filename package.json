{
  "name": "mia-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.0 || ^24.0.0 || ^26.0.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "BUILD_REVISION=$(git rev-parse HEAD) vite",
    "preview": "BUILD_REVISION=$(git rev-parse HEAD) vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check:typecheck-coverage": "node scripts/check-typecheck-coverage.mjs",
    "lint": "eslint . --max-warnings 0 && node scripts/check-architecture.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "BUILD_REVISION=$(git rev-parse HEAD) vite build",
    "test:e2e": "npm run build && npm run test:e2e:built",
    "test:e2e:built": "playwright install chromium && node scripts/owned-preview.mjs -- node_modules/.bin/playwright test",
    "test:e2e:owned": "playwright test",
    "check:browser-gate:built": "node scripts/owned-preview.mjs -- bash scripts/check-browser-gate.sh",
    "test:preview-runner": "node --test scripts/preview-runner.test.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:i18n": "node scripts/check-i18n-catalogs.mjs",
    "generate:api": "openapi-typescript mia/api-doc/openapi.yaml -o src/platform/api/generated.ts && prettier --write src/platform/api/generated.ts",
    "check:api-types": "bash scripts/check-api-types.sh"
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "@heroicons/react": "2.2.0",
    "@tanstack/react-query": "5.102.8",
    "clsx": "2.1.1",
    "katex": "0.18.7",
    "mdast-util-gfm-table": "2.0.0",
    "micromark-extension-gfm-table": "2.1.2",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-intl": "11.0.1",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@formatjs/cli": "6.16.29",
    "@formatjs/icu-messageformat-parser": "3.5.19",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
